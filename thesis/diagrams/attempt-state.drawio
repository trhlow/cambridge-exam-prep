"rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="v13"><mxGeometry x="270" y="370" width="170" height="50" as="geometry"/></mxCell><mxCell id="v20" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v13"><mxGeometry x="104" y="384" width="24" height="24" as="geometry"/></mxCell><mxCell id="e21" value="" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="v13" source="v15" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="AttemptMarker&#xa;[đề không có Writing]" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="v13" source="v16" target="v17"><mxGeometry relative="1" as="geometry"><mxPoint x="-30" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e23" value="AttemptMarker&#xa;[có bài Writing]" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="v13" source="v16" target="v18"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e24" value="Giám khảo chấm một câu&#xa;[còn câu chưa chấm]" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=1;entryY=0.7;" edge="1" parent="v13" source="v18" target="v18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="478" y="247"/><mxPoint x="478" y="270"/></Array><mxPoint x="-70" y="-46" as="offset"/></mxGeometry></mxCell><mxCell id="e25" value="Giám khảo chấm câu Writing cuối&#xa;/ điểm = tự động + Writing" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="v13" source="v18" target="v19"><mxGeometry relative="1" as="geometry"><mxPoint x="-4" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e26" value="" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="v13" source="v17" target="v20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="v13" source="v19" target="v20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v28" value="Ghi chú&#xa;• Mọi thay đổi đồng hồ chỉ đi qua AttemptClock; giờ kết thúc do server tính.&#xa;• Thí sinh offline vẫn bị nộp đúng giờ (AttemptExpiryWorker quét mỗi 5 giây).&#xa;• Không có nút nộp bài của thí sinh (giống Cambridge): chờ hết giờ hoặc giám thị End now.&#xa;• Phần thi sau (Listening) chỉ mở khi mọi phần trước đã ở trạng thái Đã nộp." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fontFamily=Times New Roman;fontSize=14;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="820" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
