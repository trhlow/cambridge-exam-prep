<mxfile host="drawio" version="31.7.0"><diagram name="Trạng thái lượt làm bài"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v2" value="Máy trạng thái của một lượt làm bài (attempts)" style="text;html=1;fontFamily=Times New Roman;fontSize=14;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="600" height="30" as="geometry"/></mxCell><mxCell id="v3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="63" width="26" height="26" as="geometry"/></mxCell><mxCell id="v4" value="Chưa bắt đầu&#xa;(NotStarted)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="45" width="180" height="62" as="geometry"/></mxCell><mxCell id="v5" value="Đang làm (InProgress)&#xa;&#xa;entry / tính ends_at&#xa;do / tự lưu câu trả lời,&#xa;heartbeat 5 giây" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="240" height="120" as="geometry"/></mxCell><mxCell id="v6" value="Tạm dừng (Paused)&#xa;&#xa;entry / ghi paused_at&#xa;do / đồng hồ đứng yên" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="230" width="210" height="110" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Thí sinh mở phần thi&#xa;[các phần trước đã nộp]&#xa;/ AttemptClock.Start" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.54;entryY=0;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.12;entryX=0.85;entryY=0;" edge="1" parent="1" source="v5" target="v5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="244"/><mxPoint x="320" y="200"/><mxPoint x="244" y="200"/></Array></mxGeometry></mxCell><mxCell id="v10" value="Cộng giờ sự cố, End at / End in,&#xa;tua audio, Use test end time&#xa;/ tính lại ends_at" style="text;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=14;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="230" height="60" as="geometry"/></mxCell><mxCell id="e11" value="" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.55;entryX=0;entryY=0.6;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v12" value="Giám thị Pause&#xa;[thí sinh đang online]" style="text;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=14;fontSize=12;align=left;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="256" width="170" height="36" as="geometry"/></mxCell><mxCell id="e13" value="" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.9;entryX=1;entryY=0.825;" edge="1" parent="1" source="v6" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v14" value="Giám thị Resume&#xa;/ paused_seconds += thời gian dừng" style="text;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=14;fontSize=12;align=left;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="335" width="190" height="36" as="geometry"/></mxCell><mxCell id="e15" value="" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.7;entryY=1;" edge="1" parent="1" source="v6" target="v6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="533" y="380"/><mxPoint x="617" y="380"/></Array></mxGeometry></mxCell><mxCell id="v16" value="Cộng giờ sự cố, Use test end time" style="text;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=14;fontSize=12;align=left;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="384" width="230" height="22" as="geometry"/></mxCell><mxCell id="v17" value="Đã nộp (Submitted) — chấm điểm (grading_status)" style="swimlane;rounded=1;html=1;fontFamily=Times New Roman;fontSize=14;fontStyle=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="660" height="380" as="geometry"/></mxCell><mxCell id="e18" value="Hết giờ [TimeExpired]&#xa;Giám thị End now [InvigilatorEndNow]&#xa;/ ghi submitted_at" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.24;entryY=0;" edge="1" parent="1" source="v5" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v19" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v17"><mxGeometry x="190" y="57" width="22" height="22" as="geometry"/></mxCell><mxCell id="v20" value="Chưa chấm&#xa;(NotGraded)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="v17"><mxGeometry x="245" y="43" width="170" height="50" as="geometry"/></mxCell><mxCell id="v21" value="Đã chấm tự động&#xa;(AutoGraded)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="v17"><mxGeometry x="40" y="180" width="190" height="56" as="geometry"/></mxCell><mxCell id="v22" value="Chờ chấm Writing&#xa;(NeedsManualMarking)&#xa;do / giám khảo chấm từng câu" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="v17"><mxGeometry x="390" y="172" width="230" height="72" as="geometry"/></mxCell><mxCell id="v23" value="Hoàn tất&#xa;(Final)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="v17"><mxGeometry x="420" y="300" width="170" height="50" as="geometry"/></mxCell><mxCell id="v24" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v17"><mxGeometry x="123" y="313" width="24" height="24" as="geometry"/></mxCell><mxCell id="e25" value="" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="v17" source="v19" target="v20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="AttemptMarker&#xa;[đề không có Writing]" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="v17" source="v20" target="v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="AttemptMarker&#xa;[có bài Writing]" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="v17" source="v20" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="v17" source="v22" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v29" value="Giám khảo chấm câu Writing cuối&#xa;/ điểm = tự động + Writing" style="text;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=14;fontSize=12;align=left;verticalAlign=top;align=right;" vertex="1" parent="v17"><mxGeometry x="200" y="254" width="300" height="36" as="geometry"/></mxCell><mxCell id="e30" value="" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="v17" source="v21" target="v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="" style="endArrow=open;endSize=10;html=1;rounded=1;strokeColor=#333333;fontFamily=Times New Roman;fontSize=14;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="v17" source="v23" target="v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v32" value="Ghi chú&#xa;• Mọi thay đổi đồng hồ chỉ đi qua AttemptClock; giờ kết thúc do server tính.&#xa;• Thí sinh offline vẫn bị nộp đúng giờ (AttemptExpiryWorker quét mỗi 5 giây).&#xa;• Không có nút nộp bài của thí sinh (giống Cambridge): chờ hết giờ hoặc giám thị End now.&#xa;• Phần thi sau (Listening) chỉ mở khi mọi phần trước đã ở trạng thái Đã nộp." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fontFamily=Times New Roman;fontSize=14;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="875" width="660" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
