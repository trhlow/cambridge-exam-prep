# Copy to docker/.env (git-ignored) and replace the passwords.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=examprep
MYSQL_USER=examprep
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# Whole system in Docker: the site is served at http://localhost:${WEB_PORT}.
WEB_PORT=8080
# First administrator, created only while the database has none (password at least 12 characters).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
